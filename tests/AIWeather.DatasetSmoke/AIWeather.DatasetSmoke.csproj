<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <!-- NINA dependencies copy hostfxr/coreclr beside the test binary.  An apphost
         then mistakes that partial host payload for an app-local .NET install.
         Running this harness through the installed dotnet host avoids that trap. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AIWeather.csproj" />
    <!-- The plugin excludes NINA host assemblies at runtime, correctly.  This standalone
         executable calls services that log through NINA.Core, so the test host needs its
         own runtime copy.  This reference never enters the shipped plugin. -->
    <PackageReference Include="NINA.Core" Version="3.0.0.9001" />
  </ItemGroup>
</Project>
