<Window x:Class="AIWeather.Views.DatasetLabelReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:AIWeather.Localization"
        Title="{i18n:Loc Review.Title}"
        Width="1500" Height="900" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#20292E" Foreground="#E6EEF2">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#27343A"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1A2328"/>
        <SolidColorBrush x:Key="LineBrush" Color="#46565E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6EEF2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AFC0C8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#008D83"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#9D3A43"/>
        <i18n:ReviewStatusLocalizationConverter x:Key="ReviewStatusLocalizationConverter"/>
        <i18n:WeatherConditionLocalizationConverter x:Key="WeatherConditionLocalizationConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="ReviewerComboBox" TargetType="ComboBox">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#111111"/>
                </Style>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#111111"/>
                    <Setter Property="Background" Value="#E8EFF2"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#E8EFF2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="3" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{i18n:Loc Review.Search}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2" Text="{i18n:Loc Review.Status}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Style="{StaticResource ReviewerComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ReviewStatusLocalizationConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="4" Text="{Binding SummaryText}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="5" Content="{i18n:Loc Review.Refresh}" Command="{Binding RefreshCommand}"/>
                <Button Grid.Column="6" Content="{i18n:Loc Review.OpenFolder}" Command="{Binding OpenDatasetFolderCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="390" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5">
                <DataGrid ItemsSource="{Binding SamplesView}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource TextBrush}"
                          BorderThickness="0" RowBackground="#202B30" AlternatingRowBackground="#26343A"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColTime}" Binding="{Binding CapturedLocal}" Width="138"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColReview}" Binding="{Binding ReviewStatusDisplay}" Width="82"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColTeacher}" Binding="{Binding TeacherCondition}" Width="92"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColCloud}" Binding="{Binding TeacherCloud}" Width="55"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColStudent}" Binding="{Binding StudentCloud}" Width="55"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColDifference}" Binding="{Binding Difference}" Width="55"/>
                        <DataGridTextColumn Header="{i18n:Loc Review.ColReason}" Binding="{Binding Reasons}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource LineBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#111719" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="4">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding SelectedItem.ImageSummary}"
                           Style="{StaticResource DetailText}" TextAlignment="Center" Margin="4"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{i18n:Loc Review.Previous}" Command="{Binding PreviousCommand}"/>
                    <Button Content="{i18n:Loc Review.Next}" Command="{Binding NextCommand}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource LineBrush}"/>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{i18n:Loc Review.SampleOriginal}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SelectedItem.SampleId}" Style="{StaticResource DetailText}"/>
                        <TextBlock Text="{Binding SelectedItem.ProvenanceSummary}" Style="{StaticResource DetailText}"/>
                        <TextBlock Text="{Binding SelectedItem.TeacherSummary}" Style="{StaticResource DetailText}"/>
                        <TextBlock Text="{Binding SelectedItem.StudentSummary}" Style="{StaticResource DetailText}"/>
                        <TextBlock Text="{Binding SelectedItem.AstroSummary}" Style="{StaticResource DetailText}"/>
                        <TextBlock Text="{Binding SelectedItem.SelectionSummary}"
                                   Style="{StaticResource DetailText}"/>

                        <Separator Margin="0,8" Background="{StaticResource LineBrush}"/>
                        <TextBlock Text="{i18n:Loc Review.HumanReview}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SelectedItem.ReviewSummary}" Style="{StaticResource DetailText}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Loc Review.Condition}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Conditions}"
                                      SelectedItem="{Binding HumanCondition}" Margin="0,3"
                                      Style="{StaticResource ReviewerComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource WeatherConditionLocalizationConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Loc Review.CloudCoverage}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HumanCloudCoverageText}"
                                     Margin="0,3"/>
                        </Grid>

                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Content="{i18n:Loc Review.Rain}" IsChecked="{Binding HumanRainDetected}"/>
                            <CheckBox Content="{i18n:Loc Review.Fog}" IsChecked="{Binding HumanFogDetected}"/>
                        </WrapPanel>

                        <TextBlock Text="{i18n:Loc Review.Notes}" Margin="0,6,0,3"/>
                        <TextBox Text="{Binding ReviewNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="{i18n:Loc Review.ImmutableHelp}"
                                   Style="{StaticResource DetailText}" Margin="0,8,0,4"/>
                        <WrapPanel HorizontalAlignment="Center" IsEnabled="{Binding HasSelection}">
                            <Button Content="{i18n:Loc Review.Accept}" Command="{Binding AcceptTeacherCommand}"/>
                            <Button Content="{i18n:Loc Review.SaveCorrection}" Command="{Binding SaveCorrectionCommand}"/>
                            <Button Content="{i18n:Loc Review.Reject}" Command="{Binding RejectCommand}"
                                    Background="{StaticResource DangerBrush}"/>
                            <Button Content="{i18n:Loc Review.Reset}" Command="{Binding ResetReviewCommand}"
                                    Background="#56636A"/>
                            <Button Content="{i18n:Loc Review.Delete}" Command="{Binding DeleteSampleCommand}"
                                    ToolTip="{i18n:Loc Review.DeleteHelp}"
                                    Background="#A33242"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Padding="7" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding DatasetRoot}" Foreground="{StaticResource MutedBrush}"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
            </Grid>
        </Border>
    </Grid>
</Window>
